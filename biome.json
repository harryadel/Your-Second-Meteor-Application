{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			".meteor/**/*", 
			".coverage/**/*",
			"**/*.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"all": true,
				"useImportType": "off",
				"useNamingConvention": {
					"options": {
						"conventions": [
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"formats": ["camelCase", "CONSTANT_CASE"]
							}
						]
					}
				}
			},
			"correctness": {
				"all": true,
				"noUnreachable": "error"
			},
			"suspicious": {
				"all": true,
				"noConsoleLog": "warn"
			},
			"complexity": {
				"all": true,
				"useArrowFunction": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
